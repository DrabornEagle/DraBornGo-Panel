{
  "expo": {
    "name": "DraBornGo Panel",
    "slug": "draborngo-panel",
    "scheme": "draborngo-panel",
    "version": "0.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dkd-panel-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/dkd-panel-splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "draborngo-panel",
          "color": "#69E9FF"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.20.1"
        }
      ]
    ],
    "android": {
      "package": "com.draborneagle.draborngopanel",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dkd-panel-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.draborneagle.draborngopanel",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/images/dkd-panel-icon.png",
    "backgroundColor": "#000000"
  }
}
