{
  "expo": {
    "name": "DraBornGo Panel",
    "slug": "draborngo-panel",
    "version": "0.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "draborngo-panel-orders",
          "color": "#69EAFF"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "android": {
      "package": "com.draborneagle.draborngopanel",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#07111F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.draborneagle.draborngopanel",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
