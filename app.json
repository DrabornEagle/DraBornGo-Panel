{
  "expo": {
    "name": "DraBornGo Panel",
    "slug": "draborngo-panel",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "android": {
      "package": "com.draborneagle.draborngopanel",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#07111F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.draborneagle.draborngopanel",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
