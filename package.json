{
  "name": "draborngo-panel",
  "version": "0.0.2",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel --clear",
    "start:dev": "expo start --dev-client --lan --clear",
    "start:dev:tunnel": "expo start --dev-client --tunnel --clear",
    "android": "expo start --android",
    "doctor": "npx expo-doctor@latest",
    "expo:fix": "npx expo install --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rnmapbox/maps": "^10.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
